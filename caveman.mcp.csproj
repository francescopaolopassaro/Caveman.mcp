<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Caveman.Mcp</PackageId>
    <Version>1.4.3</Version>
    <Authors>Francesco Paolo Passaro</Authors>
    <Company>Digitalsolutions.it</Company>
    <Description>MCP (Model Context Protocol) server for Caveman — exposes NLP token compression, language detection, content routing, summarization, retrieval and code skeletonization as MCP tools for Claude Code, OpenCode, Cursor, and any MCP-compatible agent.</Description>
    <PackageTags>AI;NLP;LLM;MCP;PromptEngineering;Claude;Copilot;compression</PackageTags>
    <PackageReleaseNotes>1.4.3: aligned with Caveman core 1.4.3 (now referenced as a NuGet dependency instead of a project reference; 1.4.3 is a corrective re-publish of 1.4.2, which was missing several 1.4.x features). compress/compress_batch/summarize already supported the 1.4.1 statistical/syntactic levels; summarize gains a topicAware option (segments text into topics first, allocates the sentence budget proportionally). Three new tools: retrieve (BM25+ ranking over text chunks, optional RM3 pseudo-relevance feedback), skeletonize_code (strips comments and collapses function bodies to signatures), near_duplicate (SimHash-based near-duplicate detection for templated/near-identical text).</PackageReleaseNotes>
    <RepositoryUrl>https://github.com/francescopaolopassaro/caveman</RepositoryUrl>
    <PackageProjectUrl>https://github.com/francescopaolopassaro/caveman</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>caveman-icon.png</PackageIcon>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageRequireLicenseAcceptance>False</PackageRequireLicenseAcceptance>
    <Copyright>Copyright (c) 2026 Passaro Francesco Paolo - Digitalsolutions.it</Copyright>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Caveman.Mcp</RootNamespace>
    <AssemblyName>caveman-mcp</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Caveman" Version="1.4.3" />
    <PackageReference Include="ModelContextProtocol" Version="1.4.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <None Update="caveman-icon.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Update="LICENSE">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Update="NOTICE">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Update="README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>
