<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Caveman.Mcp</PackageId>
    <Version>1.5.0</Version>
    <Authors>Francesco Paolo Passaro</Authors>
    <Company>Digitalsolutions.it</Company>
    <Description>MCP (Model Context Protocol) server for Caveman — exposes NLP token compression, language detection, content routing, summarization, retrieval and code skeletonization as MCP tools for Claude Code, OpenCode, Cursor, and any MCP-compatible agent.</Description>
    <PackageTags>AI;NLP;LLM;MCP;PromptEngineering;Claude;Copilot;compression</PackageTags>
    <PackageReleaseNotes>1.5.0: aligned with Caveman core 1.5.0 and targets .NET 10. Now a real .NET tool: dotnet tool install --global Caveman.Mcp, command caveman-mcp. New tools semantic_cache_get, semantic_cache_set, semantic_cache_stats and semantic_cache_clear (algorithmic multilingual semantic cache for agents; numbers, file names and identifiers must match exactly). 1.4.5: aligned with Caveman core 1.4.5 - every compress/compress_batch call now keeps IPs, versions, dates and URLs verbatim, never corrupts JSON/code/SQL/YAML, and no longer inflates Chinese/Japanese output. 1.4.4: aligned with Caveman core 1.4.4. Two new tools: compress_sql (whitespace-safe SQL compression via CavemanSqlCompressor, with optional comment stripping and CCR value-folding) and idf_languages (lists the 56 shipped global-IDF tables and checks table/corpus size per ISO 639-3). route_content now routes SQL content to the SQL compressor (ContentType.Sql). 1.4.3 was a corrective re-publish of 1.4.2.</PackageReleaseNotes>
    <RepositoryUrl>https://github.com/francescopaolopassaro/caveman</RepositoryUrl>
    <PackageProjectUrl>https://github.com/francescopaolopassaro/caveman</PackageProjectUrl>
    <PackageReadmeFile>README.nuget.md</PackageReadmeFile>
    <PackageIcon>caveman-icon.png</PackageIcon>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageRequireLicenseAcceptance>False</PackageRequireLicenseAcceptance>
    <Copyright>Copyright (c) 2026 Passaro Francesco Paolo - Digitalsolutions.it</Copyright>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <OutputType>Exe</OutputType>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>caveman-mcp</ToolCommandName>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Caveman.Mcp</RootNamespace>
    <AssemblyName>caveman-mcp</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Caveman" Version="1.5.0" />
    <PackageReference Include="ModelContextProtocol" Version="1.4.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="caveman-icon.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Update="LICENSE">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Update="NOTICE">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="README.nuget.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>
